# Copy to .env.local and fill in values

NODE_ENV=

# Herald backend URL — used server-side by the proxy route and NextAuth providers
# Must NOT have a trailing slash
HERALD_BACKEND_URL=http://localhost:3001/v1

# Auth — NEXTAUTH_SECRET is used ONLY by NextAuth to sign its own session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# MSW mocks — set "true" to enable MSW mocks in production builds
# In development mode, mocks are always enabled regardless of this setting
NEXT_PUBLIC_ENABLE_MOCKS=false
ENABLE_MOCKS=false

# PostHog — analytics & session recording
# Find your project token at https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
